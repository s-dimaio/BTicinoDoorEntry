# Environment & secret files
.env
.env.*
*.env
env.json

# Ignore backup & local script/IDE files
bck/
*.ps1
*.bat
*.code-workspace
.agents/

# Ignore logs
log/
logs/
*.log

# Ignore certificates and private key files
/certs/
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx

# Ensure lib/certs (certificate helper code) is tracked
!/lib/certs/
!/lib/certs/**

# Ignore node modules
node_modules/

# Ignore json credential dumps & token directories
json/
token/
token_cache.json
sip_account.json
client-certs.json

# Ignore credentials generated by examples
examples/token_cache.json
examples/sip_account.json
examples/client-certs.json
examples/*.json

# Ignore manual test & reverse-engineering files that require real credentials
mitm_flows/
test_authentication.js
test_certificate_refresh.js
frida/

# Decompiled APK sources (BTicino Door Entry / Legrand DIY)
decompiled/
